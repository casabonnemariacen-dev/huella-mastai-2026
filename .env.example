# Copiá este archivo como .env.local para probar en tu computadora.

# URL base del servicio de rutas compatible con la API de OSRM (ver README, "Servicio de rutas en producción").
VITE_URL_RUTAS=https://router.project-osrm.org

# Supabase (guardado anónimo). Usá la clave PÚBLICA (publishable / anon), nunca la secret / service_role.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_CLAVE_PUBLICA=sb_publishable_xxxxxxxxxxxx
